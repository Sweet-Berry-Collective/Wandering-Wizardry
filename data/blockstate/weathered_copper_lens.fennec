[
    # X
    {
        when {
            powered = "false"
            focus = "focused"
            axis = "x"
        }
        apply {
            model = "wwizardry:block/copper_lens/weathered/unpowered/focused"
            x = 90
            y = 90
        }
    }
    {
        when {
            powered = "true"
            focus = "focused"
            axis = "x"
        }
        apply {
            model = "wwizardry:block/copper_lens/weathered/powered/focused"
            x = 90
            y = 90
