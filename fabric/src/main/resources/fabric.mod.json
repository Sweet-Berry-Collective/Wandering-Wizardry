{
  "schemaVersion": 1,
  "id": "wwizardry",
  "version": "${version}",
  "name": "Wandering Wizardry",
  "description": "An exploration focused magic mod",
  "authors": [
    "Sweet Berry Collective",
    "Octal",
    "Cart3r",
    "Moonkey",
    "EtheraelEspeon",
    "RamblesOnn",
    "SylvKT",
    "Acikek",
    "Sisby-Folk",
    "Ringlings"
  ],
  "contact": {
    "issues": "https://github.com/Sweet-Berry-Collective/Wandering-Wizardry/issues",
    "source": "https://github.com/Sweet-Berry-Collective/Wandering-Wizardry",
    "homepage": "https://sweetberry.dev"
  },
  "icon": "assets/wwizardry/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.sweetberry.wwizardry.fabric.FabricInitializer"
    ],
    "client": [
      "dev.sweetberry.wwizardry.fabric.client.FabricClientInitializer"
    ],
    "terrablender": [
      "dev.sweetberry.wwizardry.fabric.compat.terrablender.FabricTerraBlenderInitializer"
    ],
    "emi": [
      "dev.sweetberry.wwizardry.compat.emi.EmiInitializer"
    ]
  },
  "mixins": [
    "wwizardry.mixins.json",
    "wwizardry.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": ">=1.21 <=1.21.1"
  },
  "custom": {
    "cardinal-components": [
      "wwizardry:void_bag",
      "wwizardry:boat"
    ]
  }
}
